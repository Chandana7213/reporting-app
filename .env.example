# Copy to .env for local testing of cloud features (NEVER commit .env).
# Leave everything blank/unset to run in pure-local mode (Layer 1).

# Layer 4 - Cloud Storage
BUCKET_NAME=

# Layer 5 - Cloud SQL (PostgreSQL)
INSTANCE_CONNECTION_NAME=
DB_NAME=reportdb
DB_USER=reportuser

# Layer 6 - normally injected from Secret Manager, set locally only for testing
DB_PASSWORD=

# Optional
SECRET_KEY=dev-only-change-me